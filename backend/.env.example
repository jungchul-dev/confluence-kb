# ── DB (db/run.sh 가 띄우는 컨테이너, TestFlow AI 와 포트가 다르다: 5433) ──
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/confluence_kb
APP_ENV=development
CORS_ORIGINS=["http://localhost:5174"]

# ── Confluence ──
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_AUTH=basic            # basic(Cloud: 이메일+API 토큰) | bearer(Data Center: PAT)
CONFLUENCE_USER=you@example.com  # basic 일 때만
CONFLUENCE_TOKEN=change-me
CONFLUENCE_SPACES=PROJ           # 수집 대상 공간 키, 쉼표 구분
ATTACHMENT_EXTS=pdf,docx,pptx,xlsx,md,txt
ATTACHMENT_MAX_MB=20
PDF_OCR=false

# ── 모델 (OpenAI 호환 API: OpenAI, Ollama(/v1), vLLM 등) ──
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536               # 바꾸면 전체 재색인 필요

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini

RERANK_PROVIDER=none             # none(RRF 순서 그대로) | local(cross-encoder) | http(외부 TEI 서버)
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_API_URL=                  # http 선택 시 TEI 서버 베이스 URL, 예: http://rerank:8080
RERANK_API_KEY=                  # http 선택 + 인증 필요 시
RERANK_MIN_SCORE=0.3
TOP_K_CANDIDATES=50
TOP_K_FINAL=5

# ── 권한 ──
# SSO 가 넣어 주는 헤더 이름. 개발 중에는 DEV_USER_GROUPS 로 대신한다 ("*" 면 모든 문서 열람)
USER_ID_HEADER=X-User-Id
USER_GROUPS_HEADER=X-User-Groups
DEV_USER_GROUPS=*

# ── 동기화 ──
SYNC_INCREMENTAL_MINUTES=30
SKIP_SPACE_PERMISSIONS=false  # true 면 검색 시 권한 체크를 건너뛴다 (동기화는 권한을 정상 수집). 모든 사용자가 모든 문서를 검색할 수 있는 환경에서 사용
