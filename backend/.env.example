# confluence-kb 설정 — 이 파일을 .env 로 복사해 채운다. 키 설명은 app/config.py 와 같다.
# 환경 변수가 있으면 .env 값보다 우선한다. 실행 중에 바꾸면 서버를 재시작해야 반영된다.

# ── DB (db/run.sh 가 띄우는 컨테이너, TestFlow AI 와 포트가 다르다: 5433) ──
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/confluence_kb   # 유일한 필수 값. asyncpg 드라이버 사용
APP_ENV=development              # development | production. 현재 코드 분기는 없고 로그·표시용
CORS_ORIGINS=["http://localhost:5174"]   # 브라우저에서 API 를 직접 부를 때 허용할 출처(JSON 배열). 프론트 개발 서버 주소

# ── Confluence (수집 대상) ──
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki   # Cloud 는 /wiki 까지, Data Center 는 사내 URL
CONFLUENCE_AUTH=basic            # basic(Cloud: 이메일+API 토큰) | bearer(Data Center: PAT)
CONFLUENCE_USER=you@example.com  # basic 일 때만
CONFLUENCE_TOKEN=change-me       # API 토큰 또는 PAT. 읽기 전용 서비스 계정 권장
CONFLUENCE_SPACES=PROJ           # 수집 대상 공간 키, 쉼표 구분. 동기화 탭의 공간 목록도 이 값
ATTACHMENT_EXTS=pdf,docx,pptx,xlsx,md,txt   # 본문으로 풀어서 색인할 첨부 확장자. csv 도 txt 파서로 처리 가능
ATTACHMENT_MAX_MB=20             # 이보다 큰 첨부는 내려받지 않는다
PDF_OCR=false                    # true 면 텍스트 없는(스캔) PDF 페이지를 OCR. pytesseract·pdf2image + tesseract-ocr-kor 필요

# ── 모델 (OpenAI 호환 API: OpenAI, Ollama(/v1), vLLM 등) ──
EMBEDDING_BASE_URL=https://api.openai.com/v1   # 뒤에 /embeddings 를 붙여 호출. Ollama 는 http://localhost:11434/v1
EMBEDDING_API_KEY=change-me      # 인증 없는 로컬 서버(Ollama)면 비워 둔다
EMBEDDING_MODEL=text-embedding-3-small   # 예: Ollama 의 qwen3-embedding:0.6b(1024차원), bge-m3(1024차원)
EMBEDDING_DIM=1024               # 모델의 벡터 차원. chunks.embedding 컬럼 크기라 바꾸면 db/run.sh --reset 후 전체 재색인 필요
#EMBEDDING_BATCH_SIZE=64         # 임베딩 한 번 호출에 넣는 텍스트 수. CPU Ollama 가 타임아웃 나면 8~16 으로 줄인다

LLM_BASE_URL=https://api.openai.com/v1   # 뒤에 /chat/completions 를 붙여 호출. Anthropic 은 https://api.anthropic.com/v1 (OpenAI 호환 계층)
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini            # 답변 생성과 분석 탭 클러스터 제목에 쓴다
#LLM_MAX_CONTEXT_TOKENS=12000    # 답변 프롬프트에 넣는 청크 총량 상한(토큰 근사치: 한글 1자≈1, 영문 4자≈1). 모델 컨텍스트의 60% 안으로

RERANK_PROVIDER=none             # none(RRF 순서 그대로, 하한 판정 없음) | local(sentence-transformers cross-encoder, torch 필요) | http(외부 TEI 서버)
RERANK_MODEL=BAAI/bge-reranker-v2-m3   # local 이면 HuggingFace 모델 id, http 면 서버에 로드된 모델 이름
RERANK_API_URL=                  # http 선택 시 TEI 서버 베이스 URL, 예: http://rerank:8080 (뒤에 /rerank 를 붙여 호출)
RERANK_API_KEY=                  # http 선택 + 인증 필요 시
RERANK_MIN_SCORE=0.3             # 리랭커 1위 점수가 이 값 미만이면 "관련 문서를 찾지 못했다"로 응답 (local·http 에서만 동작)
TOP_K_CANDIDATES=50              # 벡터 검색·키워드 검색 각각 가져오는 후보 수이자 RRF 합산 후 남기는 상한
TOP_K_FINAL=5                    # 리랭킹 후 답변 생성에 넣는 청크 수. 검색 화면은 이 값 대신 요청의 k(기본 20)를 쓴다

# ── 청킹 (워커가 본문을 자르는 기준, 토큰은 근사치) ──
#CHUNK_TARGET_TOKENS=600         # 짧은 섹션은 이 크기까지 합친다
#CHUNK_MAX_TOKENS=900            # 이보다 긴 섹션은 문단 → 문장 순으로 나눈다
#CHUNK_OVERLAP_RATIO=0.1         # 다음 청크 앞에 직전 청크 끝부분을 이 비율만큼 겹쳐 둔다 (0 이면 겹침 없음)

# ── 권한 ──
# SSO 리버스 프록시가 넣어 주는 헤더 이름. 개발 중에는 헤더가 없으므로 DEV_USER_GROUPS 를 쓴다 ("*" 면 모든 문서 열람)
USER_ID_HEADER=X-User-Id         # 사용자 id 헤더. 질의 로그(queries.user_id)에 남는다
USER_GROUPS_HEADER=X-User-Groups # 그룹 목록 헤더(쉼표 구분). documents.allowed_groups 와 교집합이 있는 문서만 검색된다
DEV_USER_GROUPS=*                # 헤더가 없을 때 쓰는 그룹. 운영에서는 비우거나 실제 그룹으로

# ── 동기화 ──
SYNC_INCREMENTAL_MINUTES=30      # sync.sh --loop 로 돌릴 때 증분 동기화 간격(분). cron 을 쓰면 무시된다
SKIP_SPACE_PERMISSIONS=false     # true 면 검색·분석 시 권한 필터를 건너뛴다 (동기화는 권한을 정상 수집). 모든 사용자가 모든 문서를 볼 수 있는 환경에서만

# ── 공간 내보내기(zip) 적재 — API 호출이 막힌 환경에서 브라우저로 받은 HTML 내보내기를 ./sync.sh --source export 로 넣을 때 ──
EXPORT_ALLOWED_GROUPS=*          # 내보내기에는 권한 정보가 없으므로 문서에 붙일 열람 그룹을 지정. 공통: "pm,finance" / 공간별: "PROJ=pm;NET=infra;*=*"
