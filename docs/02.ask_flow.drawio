<mxfile host="Electron"><diagram id="02.ask_flow.drawio" name="02 질문 — POST /api/v1/ask"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="사용자 — 프론트 &#x27;질문&#x27; 탭 (AskView)" style="swimlane;startSize=34;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1680" height="170" as="geometry" /></mxCell><mxCell id="c3" value="API 서버 — routers/ask.py · services/retrieval · rerank · context · answer" style="swimlane;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1680" height="620" as="geometry" /></mxCell><mxCell id="c4" value="저장 — PostgreSQL" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1680" height="170" as="geometry" /></mxCell><mxCell id="c5" value="질문 입력&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;POST /ask?stream=true { question }&lt;br&gt;Enter 전송&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="30" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c6" value="출처 (오른쪽 칸)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;meta 이벤트로 먼저 도착: 제목 · 경로&lt;br&gt;수정일 · 점수 · 못 찾음이면 &#x27;비슷한 문서&#x27;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="1150" y="50" width="240" height="100" as="geometry" /></mxCell><mxCell id="c7" value="답변 (왼쪽 칸)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;delta 조각을 이어 붙여 표시 · [n] 출처 번호&lt;br&gt;done 에 query_id · 소요 시간&lt;/font&gt;" s