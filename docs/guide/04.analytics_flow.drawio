<mxfile host="Electron"><diagram id="04.analytics_flow.drawio" name="04 분석 — GET /api/v1/admin/clusters"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="사용자 — 프론트 &#x27;분석&#x27; 탭 (AnalyticsView)" style="swimlane;startSize=34;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1680" height="170" as="geometry" /></mxCell><mxCell id="c3" value="API 서버 — routers/analytics.py (scikit-learn K-Means)" style="swimlane;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1680" height="620" as="geometry" /></mxCell><mxCell id="c4" value="저장 — PostgreSQL" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1680" height="170" as="geometry" /></mxCell><mxCell id="c5" value="분석 버튼&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /admin/clusters?k=0&amp;llm=true&lt;br&gt;k=0 자동 · 숫자면 그 개수&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="30" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c6" value="원형 패킹 차트 + 문서 목록&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;원 크기 = 문서 수 · 제목 = LLM 라벨&lt;br&gt;클릭 → 오른쪽 목록 20건씩 페이징&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="1430" y="50" width="240" height="100" as="geometry" /></mxCell><mxCell id="c7" value="문서 벡터 조회&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;documents.embedding (제목 + 접두 뺀 본문)&lt;br&gt;없으면 chunks 평균 · 권한 필터 · id 순 정렬&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="30" y="330" width="240" height="100" as="geometry" /></mxCell><mxCell id="c8" value="정규화&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;벡터 길이를 1로 → 유클리드 K-Means 가&lt;br&gt;코사인 기준과 같아짐&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="310" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c9" value="k 선택&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;k&gt;0: 그대로&lt;br&gt;k=0: 2~min(20, n/5) 중 실루엣(코사인) 최대&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="590" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c10" value="K-Means&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;random_state=42 · n_init=10&lt;br&gt;클러스터 = 중심에 가장 가까운 문서들&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="870" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c11" value="클러스터별 정리&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;대표 문서: 중심 근접 순, 페이지 중복 제거&lt;br&gt;키워드: 본문(B) TF-IDF 상위 10 (10분 캐시)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="1150" y="330" width="240" height="100" as="geometry" /></mxCell><mxCell id="c12" value="LLM 제목&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;키워드 10 + 대표 제목 10 → 6단어 명사구&lt;br&gt;클러스터별 병렬 · 구성 해시로 캐시 · 실패 시 키워드 제목&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="1430" y="330" width="240" height="100" as="geometry" /></mxCell><mxCell id="c13" value="제목 LLM&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;answer.chat() · max_tokens 60&lt;br&gt;llm=false 면 호출 안 함&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c3"><mxGeometry x="1150" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c14" value="documents&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;embedding · allowed_groups&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c4"><mxGeometry x="30" y="50" width="240" height="100" as="geometry" /></mxCell><mxCell id="c15" value="chunks.tsv&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;ts_stat 로 클러스터 단어 통계&lt;br&gt;(접두 A 제외, 본문 B 만)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c4"><mxGeometry x="1150" y="50" width="240" height="100" as="geometry" /></mxCell><mxCell id="c16" value="클러스터링에는 본문 임베딩만 쓰고 공간·제목·날짜 같은 메타데이터는 쓰지 않는다. 응답: clusters[{label, keywords, representative_docs, all_docs, doc_count}], k, silhouette, docs_without_embedding." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1135" width="1680" height="50" as="geometry" /></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.4583;entryY=0;" edge="1" parent="1" source="c5" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="n × 1024" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="k" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="라벨 · 중심" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="키워드 · 대표 제목" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="c7" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.25;exitY=0;entryX=1;entryY=0.5;dashed=1;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1530" y="440" /><mxPoint x="1425" y="440" /><mxPoint x="1425" y="370" /></Array></mxGeometry></mxCell><mx