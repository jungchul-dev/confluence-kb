<mxfile host="Electron"><diagram id="01.ingest_confluence_to_db.drawio" name="01 수집 — Confluence API 에서 DB 적재까지"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1260" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="Confluence REST API (사내) — worker/confluence_client.py" style="swimlane;startSize=34;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1680" height="200" as="geometry" /></mxCell><mxCell id="c3" value="동기화 워커 — worker/run_sync.py · parsers · chunker · indexer  (초기 적재 full / 증분 incremental 동일 코드)" style="swimlane;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1680" height="620" as="geometry" /></mxCell><mxCell id="c4" value="PostgreSQL 16 + pgvector + textsearch_ko (db/)" style="swimlane;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1680" height="200" as="geometry" /></mxCell><mxCell id="c5" value="페이지 조회&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /rest/api/content/search&lt;br&gt;CQL: space=KEY AND type=page&lt;br&gt;증분: lastmodified ≥ 마지막 성공 시각&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="30" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c6" value="첨부 목록&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /content/{id}/child/attachment&lt;br&gt;파일명 · 크기 · 버전&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="310" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c7" value="첨부 다운로드&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /download/attachments/…&lt;br&gt;바이너리 (메모리 처리)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="590" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c8" value="공간 read 권한&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /space/{key}?expand=permissions&lt;br&gt;페이지 제한(restrictions)이 없을 때 사용&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="1150" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c9" value="첨부 필터&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;허용 확장자(pdf·docx·pptx·xlsx·md·txt)&lt;br&gt;크기 상한 · documents.version 비교&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="310" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c10" value="첨부 파서&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;pdf=페이지 · docx=헤딩 · pptx=슬라이드&lt;br&gt;xlsx=시트 행 문장 → 섹션&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="590" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c11" value="임베딩 모델&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;OpenAI 호환 POST /embeddings&lt;br&gt;(Ollama · OpenAI · vLLM) 배치 64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c3"><mxGeometry x="1150" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c12" value="공간 순회&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;CONFLUENCE_SPACES 순서대로&lt;br&gt;페이지를 하나씩 처리&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="30" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c13" value="변경 감지&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;version + 본문 해시 ↔ sync_state&lt;br&gt;같으면 건너뜀 · 다르면 재색인&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="310" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c14" value="storage HTML 파싱&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;h1~h3 로 섹션 분리 · 표 → &#x27;헤더: 값&#x27; 행&lt;br&gt;매크로 규칙(code·status·panel) · toc 등 제외&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="590" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c15" value="청킹&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;섹션을 600~900 토큰으로 · 10% 겹침&lt;br&gt;각 청크 앞에 [공간 › 상위 › 제목 › 섹션]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="870" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c16" value="임베딩 배치&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;청크 N개 + 문서 1개(제목 + 접두 뺀 본문)&lt;br&gt;를 한 번에 호출&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="1150" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c17" value="적재 (문서 단위 트랜잭션)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;documents upsert → 기존 chunks 삭제 → 삽입&lt;br&gt;allowed_groups 저장 · sync_state 갱신&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="1430" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c18" value="삭제 페이지 정리 (full 모드)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Confluence 에 없고 sync_state 에만&lt;br&gt;남은 페이지의 documents·chunks 삭제&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c3"><mxGeometry x="30" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c19" value="sync_runs 기록&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;공간별 실행 1건: seen · indexed&lt;br&gt;attachments · deleted · errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c3"><mxGeometry x="310" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c20" value="sync_state · sync_runs&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;page_id · version · hash · error&lt;br&gt;실행 이력 (동기화 탭)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c4"><mxGeometry x="30" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c21" value="documents&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;페이지·첨부 메타 · url · allowed_groups&lt;br&gt;embedding(문서, 분석·유사문서용)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c4"><mxGeometry x="1150" y="50" width="260" height="100" as="geometry" /></mxCell><mxCell id="c22" value="chunks&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;content(접두 포함) · embedding(1024, HNSW)&lt;br&gt;tsv = korean 접두 A + 본문 B (GIN)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c4"><mxGeometry x="1430" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c23" value="문서(페이지 또는 첨부) 하나가 트랜잭션 단위라 중간에 실패해도 이전 청크가 남아 검색은 계속된다. 실패는 sync_state.error 에 남기고 다음 페이지로 넘어간다. 권한은 페이지 read 제한 그룹 → 없으면 공간 read 그룹 → 없으면 &#x27;*&#x27;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="1195" width="1680" height="50" as="geometry" /></mxCell><mxCell id="c24" value="페이지 목록" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c5" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="첨부 목록" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="바이너리" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="read 그룹 → allowed_groups" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0.75;entryY=0;" edge="1" parent="1" source="c8" target="c16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1425" y="140" /><mxPoint x="1425" y="470" /><mxPoint x="1355" y="470" /></Array></mxGeometry></mxCell><mxCell id="c28" value="페이지의 첨부" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c13" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="순회 끝 (full)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c12" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="삭제 · 상태 정리" style="edgeStyle=or