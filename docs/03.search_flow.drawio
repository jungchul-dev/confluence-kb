<mxfile host="Electron"><diagram id="03.search_flow.drawio" name="03 검색 — GET /api/v1/search · /related-documents"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c2" value="사용자 — 프론트 &#x27;검색&#x27; 탭 (SearchView)" style="swimlane;startSize=34;fillColor=#ffe6cc;strokeColor=#d79b00;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1680" height="170" as="geometry" /></mxCell><mxCell id="c3" value="API 서버 — routers/search.py · analytics.py · services/retrieval · rerank" style="swimlane;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1680" height="620" as="geometry" /></mxCell><mxCell id="c4" value="검색어 입력&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /search?q=…&amp;k=20&lt;br&gt;답변 생성 없음&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="30" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c5" value="결과 목록 (왼쪽 칸)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;청크 20개: 관련도 % 막대 · [의미 n위] [키워드 n위]&lt;br&gt;하한 미만이면 경고만 (결과는 그대로)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="870" y="50" width="260" height="100" as="geometry" /></mxCell><mxCell id="c6" value="상세 (오른쪽 칸)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;항목 클릭 → 청크 본문 · 원문 링크&lt;br&gt;+ 유사 문서 5개 (유사도 %)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c2"><mxGeometry x="1430" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c7" value="사용자 식별&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;X-User-Id · X-User-Groups 헤더&lt;br&gt;개발 중: DEV_USER_GROUPS=* (전체 열람)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="30" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c8" value="임베딩 모델&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;OpenAI 호환 /embeddings&lt;br&gt;질의 1건&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="c3"><mxGeometry x="310" y="50" width="220" height="100" as="geometry" /></mxCell><mxCell id="c9" value="질의 임베딩&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;질문 문자열 전체를 벡터로&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="310" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c10" value="벡터 검색&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;chunks.embedding 코사인 거리 상위 50&lt;br&gt;WHERE allowed_groups &amp;&amp; 사용자 그룹&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="590" y="190" width="220" height="100" as="geometry" /></mxCell><mxCell id="c11" value="chunks ⋈ documents&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;embedding · tsv · allowed_groups&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c3"><mxGeometry x="590" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c12" value="키워드 검색&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;websearch_to_tsquery(&#x27;korean&#x27;) AND 상위 50&lt;br&gt;0건이면 &#x27;&amp;&#x27;→&#x27;|&#x27; OR 로 재검색 · ts_rank_cd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="590" y="470" width="220" height="100" as="geometry" /></mxCell><mxCell id="c13" value="RRF 합산&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;점수 = Σ 1/(60+순위) · 같은 청크는 합침&lt;br&gt;점수순 상위 50 후보&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="870" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c14" value="리랭킹&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;질문과 같은 리랭커 · 상위 k=20&lt;br&gt;passed(1위 ≥ 하한) 플래그만 함께 반환&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="1150" y="330" width="220" height="100" as="geometry" /></mxCell><mxCell id="c15" value="그룹" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="질의 벡터" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="625" /><mxPoint x="585" y="510" /></Array></mxGeometry></mxCell><mxCell id="c18" value="질의 문자열" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="585" y="675" /><mxPoint x="585" y="790" /></Array></mxGeometry></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="벡터 순위" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="510" /><mxPoint x="865" y="625" /></Array></mxGeometry></mxCell><mxCell id="c22" value="키워드 순위" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="865" y="790" /><mxPoint x="865" y="675" /></Array></mxGeometry></mxCell><mxCell id="c23" value="후보 ≤ 50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="유사 문서&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GET /related-documents?document_id=…&amp;k=5&lt;br&gt;documents.embedding 코사인 상위 5 · 권한 필터&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c3"><mxGeometry x="1430" y="330" width="240" height="100" as="geometry" /></mxCell><mxCell id="c25" value="documents&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;embedding (제목 + 접두 뺀 본문)&lt;br&gt;없으면 chunks 평균으로 대체&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;boundedLbl=1;size=12;" vertex="1" parent="c3"><mxGeometry x="1430" y="470" width="240" height="100" as="geometry" /></mxCell><mxCell id="c26" value="검색 결과의 순위는 청크 단위(벡터 순위·키워드 순위·RRF/리랭커 점수)이고, 유사 문서는 문서 단위 임베딩으로 계산한다. 청크 임베딩에는 경로 접두가 들어 있어 프로젝트·공간이 비슷하면 가까워지지만, 문서 임베딩은 접두를 빼서 내용 기준으로 비교한다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="905" width="1680" height="60" as="geometry" /></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="results[] · passed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="c14" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="300" /><mxPoint x="1105" y="300" /></Array></mxGeometry></mxCell><mxCell id="c29" value="클릭 (document_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c5" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1425" y="140" /><mxPoint x="1425" y="650" /></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="유사 문서 5개" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;flowAnimation=1;fontSize=14;exitX=0.75;exitY=0;entryX=0.8182;entryY=1;" edge="1" parent="1" source="c24" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>